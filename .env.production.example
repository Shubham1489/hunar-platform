# ══════════════════════════════════════════════════════════════
# HUNAR — Production Environment Variables
# Copy to .env and fill in values marked with [REQUIRED]
# ══════════════════════════════════════════════════════════════

# ─── Database (Supabase) ───────────────────────
# Get from: https://supabase.com → Project → Settings → Database → Connection String
DATABASE_URL=                   # [REQUIRED] postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── Redis (Upstash) ──────────────────────────
# Get from: https://upstash.com → Database → Details → REST URL
REDIS_URL=                      # [REQUIRED] rediss://default:[password]@[region].upstash.io:6379

# ─── Auth / JWT ───────────────────────────────
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=              # [REQUIRED] Min 32 characters
JWT_REFRESH_SECRET=             # [REQUIRED] Min 32 characters (different from above!)
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=30d

# ─── OTP ──────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# ─── SMS Provider ────────────────────────────
SMS_PROVIDER=console            # Use 'console' for dev (prints OTP to logs), 'msg91' or 'twilio' for prod

# MSG91 (if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=HUNAR

# Twilio (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── AI Service ───────────────────────────────
AI_SERVICE_URL=http://localhost:8000   # For Render: https://hunar-ai.onrender.com
AI_SERVICE_API_KEY=internal-ai-service-key

# ─── Razorpay (Payments) ─────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=                # [OPTIONAL] rzp_test_xxxx for testing
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_COMMISSION_RATE=0.10

# ─── Firebase (Push Notifications) ───────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Google Maps ──────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── AWS S3 / Cloudinary (File Storage) ──────
# Option A: AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=hunar-uploads
CLOUDFRONT_URL=

# Option B: Cloudinary (free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── App Config ───────────────────────────────
NODE_ENV=production
PORT=3001
WEB_URL=https://hunar-web.vercel.app    # Your Vercel URL
API_URL=https://hunar-api.onrender.com  # Your Render URL
CORS_ORIGINS=https://hunar-web.vercel.app

# ─── Rate Limiting ───────────────────────────
RATE_LIMIT_AUTH=100
RATE_LIMIT_UNAUTH=20
