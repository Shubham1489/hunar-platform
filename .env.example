# ──────────────────────────────────────────────
# HUNAR — Environment Variables
# Copy this to .env and fill in real values
# ──────────────────────────────────────────────

# ─── Database ─────────────────────────────────
DATABASE_URL=postgresql://hunar:hunar_secret@localhost:5432/hunar_db?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth / JWT ───────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=30d

# ─── OTP ──────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# ─── AI Service ───────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal-ai-service-key

# ─── Razorpay ────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
PLATFORM_COMMISSION_RATE=0.10

# ─── SMS / OTP Provider ──────────────────────
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=HUNAR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Firebase / FCM ──────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Google Maps ──────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── AWS S3 ───────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=hunar-uploads
CLOUDFRONT_URL=

# ─── App ──────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ───────────────────────────
RATE_LIMIT_AUTH=100
RATE_LIMIT_UNAUTH=20
